package templates

import (
	"github.com/Robert-litts/fantasy-football-archive/internal/archive"
	teamsview "github.com/Robert-litts/fantasy-football-archive/internal/teamsview"
	"strconv"
)

templ Teams(page teamsview.PageData) {
	<div class="min-h-screen px-4 py-8">
		<div class="mx-auto max-w-7xl">
			<div class="rounded-2xl border border-slate-700 bg-slate-950/80 p-6 shadow-2xl shadow-black/20">
				<div class="mb-6 flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
					<div>
						<p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-400">Archive view</p>
						<h1 class="text-3xl font-bold text-white">Fantasy Football Teams</h1>
						<p class="mt-2 max-w-3xl text-sm leading-6 text-slate-400">
							Season-by-season team results across ESPN and Sleeper, using the same unified archive view as the homepage and leagues page.
						</p>
						<div class="mt-4 flex flex-wrap gap-2">
							<span class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.22em] text-slate-300">
								ESPN 2013-2021
							</span>
							<span class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.22em] text-slate-300">
								Sleeper 2022-present
							</span>
							if page.SleeperAvailable {
								<span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.22em] text-emerald-200">
									Sleeper archive connected
								</span>
							} else {
								<span class="rounded-full border border-amber-500/30 bg-amber-500/10 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.22em] text-amber-100">
									Sleeper archive unavailable
								</span>
							}
						</div>
					</div>
					<div class="rounded-full border border-slate-700 bg-slate-900 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-300">
						{ strconv.Itoa(len(page.Leagues)) } seasons loaded
					</div>
				</div>
				<div class="space-y-6">
					@LeagueTeamSelector(page.Leagues, page.SelectedLeagueKey)
					if page.SleeperMessage != "" {
						<div class="rounded-xl border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-100">
							{ page.SleeperMessage }
						</div>
					}
					<div id="teams-dashboard">
						@TeamsTable(page)
					</div>
				</div>
			</div>
		</div>
	</div>
}

func teamsLeagueSelectionKey(league archive.LeagueSummary) string {
	return string(league.Provider) + ":" + strconv.FormatInt(league.ID, 10)
}

templ LeagueTeamSelector(leagues []archive.LeagueSummary, selectedLeagueKey string) {
	<div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-4 shadow-inner shadow-black/10">
		<label for="league-select" class="block text-xs font-bold uppercase tracking-[0.22em] text-slate-500">Select season</label>
		<select
			id="league-select"
			hx-get="/app/fragments/teams-table"
			hx-target="#teams-dashboard"
			hx-swap="innerHTML"
			hx-trigger="change"
			name="id"
			class="mt-3 w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm font-semibold text-slate-100 outline-none transition focus:border-amber-300/50 focus:ring-2 focus:ring-amber-300/20 sm:w-auto"
			>
				for _, league := range leagues {
					<option
						value={ teamsLeagueSelectionKey(league) }
						selected?={ teamsLeagueSelectionKey(league) == selectedLeagueKey }
					>
						{ strconv.Itoa(int(league.Season)) } · { string(league.Provider) } · { league.Name }
					</option>
				}
			</select>
	</div>
}

templ TeamsTable(page teamsview.PageData) {
	<div class="overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/60 shadow-xl">
				<div class="border-b border-slate-800 px-5 py-4">
					<div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
						<div>
							<p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Season detail</p>
							if page.SelectedLeague.Name != "" {
								<h2 class="mt-1 text-2xl font-bold text-white">{ page.SelectedLeague.Name }</h2>
								<p class="mt-1 text-sm text-slate-400">
									{ string(page.SelectedLeague.Provider) } · Season { strconv.Itoa(int(page.SelectedLeague.Season)) } · { strconv.Itoa(len(page.Teams)) } teams loaded
								</p>
							} else {
								<h2 class="mt-1 text-2xl font-bold text-white">No season selected</h2>
								<p class="mt-1 text-sm text-slate-400">Choose a league to load the season standings.</p>
							}
						</div>
				<div class="rounded-full border border-slate-700 bg-slate-950 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-300">
					{ strconv.Itoa(len(page.Teams)) } rows
				</div>
			</div>
		</div>
		<div class="overflow-x-auto">
			<table class="min-w-full divide-y divide-slate-800 bg-slate-950">
				<thead class="bg-slate-900/80">
					<tr>
						<th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Owner</th>
						<th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Wins</th>
						<th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Losses</th>
						<th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Ties</th>
						<th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Standing</th>
						<th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">PF</th>
						<th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">PA</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-800 bg-slate-950">
					for _, team := range page.Teams {
						<tr class="transition-colors hover:bg-slate-900/70">
							<td class="px-5 py-4 text-sm text-slate-200">
								<div class="font-semibold text-white">{ team.OwnerLabel }</div>
								if team.TeamLabel != "" {
									<div class="mt-1 text-xs text-slate-500">{ team.TeamLabel }</div>
								}
							</td>
							<td class="whitespace-nowrap px-5 py-4 text-sm text-slate-300">{ strconv.Itoa(int(team.Wins)) }</td>
							<td class="whitespace-nowrap px-5 py-4 text-sm text-slate-300">{ strconv.Itoa(int(team.Losses)) }</td>
							<td class="whitespace-nowrap px-5 py-4 text-sm text-slate-300">{ strconv.Itoa(int(team.Ties)) }</td>
							<td class="whitespace-nowrap px-5 py-4 text-sm text-slate-300">{ strconv.Itoa(int(team.FinalStanding)) }</td>
							<td class="whitespace-nowrap px-5 py-4 text-sm text-slate-300">{ team.PointsFor }</td>
							<td class="whitespace-nowrap px-5 py-4 text-sm text-slate-300">{ team.PointsAgainst }</td>
						</tr>
					}
					if len(page.Teams) == 0 {
						<tr>
							<td colspan="7" class="px-5 py-8 text-center text-sm text-slate-500">
								No teams found for this season.
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}
