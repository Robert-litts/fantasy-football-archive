package templates

import (
	"fmt"
	"github.com/Robert-litts/fantasy-football-archive/internal/archive"
	draftsview "github.com/Robert-litts/fantasy-football-archive/internal/draftsview"
	"strconv"
	"strings"
)

func draftPlayerImageURL(playerEspnID string) string {
	playerEspnID = strings.TrimSpace(playerEspnID)
	if playerEspnID == "" || playerEspnID == "0" {
		return ""
	}
	return fmt.Sprintf("https://a.espncdn.com/combiner/i?img=/i/headshots/nfl/players/full/%s.png&w=96&h=96&scale=crop", playerEspnID)
}

func draftPlayerInitials(name string) string {
	parts := strings.Fields(name)
	if len(parts) == 0 {
		return "?"
	}

	first := firstCharacter(parts[0])
	if len(parts) == 1 {
		return strings.ToUpper(first)
	}

	last := firstCharacter(parts[len(parts)-1])
	return strings.ToUpper(first + last)
}

func firstCharacter(value string) string {
	for _, r := range value {
		return string(r)
	}

	return ""
}

func draftsLeagueSelectionKey(league archive.LeagueSummary) string {
	return string(league.Provider) + ":" + strconv.FormatInt(league.ID, 10)
}

func draftRoundGridStyle(teamCount int32) string {
	if teamCount < 1 {
		teamCount = 1
	}
	return fmt.Sprintf("grid-template-columns: repeat(%d, minmax(13rem, 1fr));", teamCount)
}

func draftPickForSlot(picks []draftsview.PickRow, round, pick int32) (draftsview.PickRow, bool) {
	for _, draftPick := range picks {
		if draftPick.RoundNum == round && draftPick.RoundPick == pick {
			return draftPick, true
		}
	}
	return draftsview.PickRow{}, false
}

func draftPositionClass(position string) string {
	base := "min-h-44 rounded-xl border-2 bg-slate-950 p-4 shadow-lg shadow-black/10 transition-colors"
	switch strings.ToUpper(strings.TrimSpace(position)) {
	case "QB":
		return base + " border-rose-400/70 hover:border-rose-300"
	case "RB":
		return base + " border-emerald-400/70 hover:border-emerald-300"
	case "WR":
		return base + " border-sky-400/70 hover:border-sky-300"
	case "TE":
		return base + " border-orange-400/75 hover:border-orange-300"
	case "K":
		return base + " border-violet-400/70 hover:border-violet-300"
	case "DEF", "DST", "D/ST":
		return base + " border-yellow-300/70 hover:border-yellow-200"
	default:
		return base + " border-slate-800 hover:border-amber-300/50"
	}
}

func draftPositionAvatarClass(position string) string {
	return "relative flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-full bg-slate-900 ring-1 ring-slate-700"
}

func draftPositionBadgeClass(position string) string {
	base := "mt-1 inline-flex rounded-full border px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.16em]"
	switch strings.ToUpper(strings.TrimSpace(position)) {
	case "QB":
		return base + " border-rose-300/30 bg-rose-300/10 text-rose-100"
	case "RB":
		return base + " border-emerald-300/30 bg-emerald-300/10 text-emerald-100"
	case "WR":
		return base + " border-sky-300/30 bg-sky-300/10 text-sky-100"
	case "TE":
		return base + " border-orange-300/35 bg-orange-300/10 text-orange-100"
	case "K":
		return base + " border-violet-300/30 bg-violet-300/10 text-violet-100"
	case "DEF", "DST", "D/ST":
		return base + " border-yellow-200/30 bg-yellow-200/10 text-yellow-100"
	default:
		return base + " border-slate-700 bg-slate-900 text-slate-400"
	}
}

templ Drafts(page draftsview.PageData) {
	<div class="min-h-screen px-4 py-8">
		<div class="mx-auto max-w-7xl">
			<div class="rounded-2xl border border-slate-700 bg-slate-950/80 p-6 shadow-2xl shadow-black/20">
				<div class="mb-6 flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
					<div>
						<p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-400">Archive view</p>
						<h1 class="text-3xl font-bold text-white">Fantasy Football Drafts</h1>
						<p class="mt-2 max-w-3xl text-sm leading-6 text-slate-400">
							Round-by-round draft history across ESPN and Sleeper, normalized into the same season browser as teams and matchups.
						</p>
						<div class="mt-4 flex flex-wrap gap-2">
							<span class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.22em] text-slate-300">
								ESPN 2013-2021
							</span>
							<span class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.22em] text-slate-300">
								Sleeper 2022-present
							</span>
							if page.SleeperAvailable {
								<span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.22em] text-emerald-200">
									Sleeper archive connected
								</span>
							} else {
								<span class="rounded-full border border-amber-500/30 bg-amber-500/10 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.22em] text-amber-100">
									Sleeper archive unavailable
								</span>
							}
						</div>
					</div>
					<div class="rounded-full border border-slate-700 bg-slate-900 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-300">
						{ strconv.Itoa(len(page.Leagues)) } seasons loaded
					</div>
				</div>
				<div id="drafts-content">
					@DraftContent(page)
				</div>
			</div>
		</div>
	</div>
}

templ DraftContent(page draftsview.PageData) {
	<div class="space-y-6">
		@LeagueDraftSelector(page.Leagues, page.SelectedLeagueKey)
		if page.SleeperMessage != "" {
			<div class="rounded-xl border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-100">
				{ page.SleeperMessage }
			</div>
		}
		<div class="overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/60 shadow-xl">
			<div class="border-b border-slate-800 px-5 py-4">
				<div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
					<div>
						<p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Season detail</p>
						if page.SelectedLeague.Name != "" {
							<h2 class="mt-1 text-2xl font-bold text-white">{ page.SelectedLeague.Name }</h2>
							<p class="mt-1 text-sm text-slate-400">
								{ string(page.SelectedLeague.Provider) } · Season { strconv.Itoa(int(page.SelectedLeague.Season)) } · { strconv.Itoa(len(page.Picks)) } picks loaded
							</p>
						} else {
							<h2 class="mt-1 text-2xl font-bold text-white">No season selected</h2>
							<p class="mt-1 text-sm text-slate-400">Choose a league to load draft history.</p>
						}
					</div>
					<div class="rounded-full border border-slate-700 bg-slate-950 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-300">
						{ strconv.Itoa(page.MaxRounds) } rounds
					</div>
				</div>
			</div>
			@DraftBoard(page)
		</div>
	</div>
}

templ LeagueDraftSelector(leagues []archive.LeagueSummary, selectedLeagueKey string) {
	<div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-4 shadow-inner shadow-black/10">
		<label for="drafts-league-select" class="block text-xs font-bold uppercase tracking-[0.22em] text-slate-500">Select season</label>
		<select
			id="drafts-league-select"
			hx-get="/app/fragments/draft-board"
			hx-target="#drafts-content"
			hx-swap="innerHTML"
			hx-trigger="change"
			name="id"
			class="mt-3 w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm font-semibold text-slate-100 outline-none transition focus:border-amber-300/50 focus:ring-2 focus:ring-amber-300/20 sm:w-auto"
		>
			for _, league := range leagues {
				<option
					value={ draftsLeagueSelectionKey(league) }
					selected?={ draftsLeagueSelectionKey(league) == selectedLeagueKey }
				>
					{ strconv.Itoa(int(league.Season)) } · { string(league.Provider) } · { league.Name }
				</option>
			}
		</select>
	</div>
}

templ DraftBoard(page draftsview.PageData) {
	<div id="draftboard-container" class="p-5">
		if len(page.Picks) > 0 {
			<div class="space-y-6">
				for round := 1; round <= page.MaxRounds; round++ {
					<div>
						<div class="mb-3 flex items-center justify-between">
							<h3 class="text-sm font-bold uppercase tracking-[0.22em] text-slate-400">Round { strconv.Itoa(round) }</h3>
						</div>
						<div class="overflow-x-auto pb-2">
							<div class="grid min-w-max gap-3" style={ draftRoundGridStyle(page.TeamCount) }>
								for pick := 1; pick <= int(page.TeamCount); pick++ {
									if draftPick, ok := draftPickForSlot(page.Picks, int32(round), int32(pick)); ok {
										@DraftPickCard(draftPick)
									} else {
										<div class="min-h-44 rounded-xl border border-dashed border-slate-800 bg-slate-950/60"></div>
									}
								}
							</div>
						</div>
					</div>
				}
			</div>
		} else {
			<div class="rounded-2xl border border-slate-800 bg-slate-950 px-5 py-10 text-center text-sm text-slate-500">
				No draft data found for this season.
			</div>
		}
	</div>
}

templ DraftPickCard(draftPick draftsview.PickRow) {
	<div class={ draftPositionClass(draftPick.Position) }>
		<div class="flex h-full flex-col gap-3">
			<div class="flex items-center justify-between gap-3">
				<span class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
					Pick { strconv.Itoa(int(draftPick.RoundPick)) }
				</span>
				<span class="rounded-full border border-slate-700 bg-slate-900 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.16em] text-slate-300">
					#{ strconv.Itoa(int(draftPick.OverallPick)) }
				</span>
			</div>
			<div class="flex items-center gap-3">
				<div class={ draftPositionAvatarClass(draftPick.Position) }>
					<span class="text-sm font-semibold tracking-wide text-slate-300">{ draftPlayerInitials(draftPick.PlayerName) }</span>
					if draftPlayerImageURL(draftPick.PlayerESPNID) != "" {
						<img
							src={ draftPlayerImageURL(draftPick.PlayerESPNID) }
							alt={ draftPick.PlayerName + " headshot" }
							loading="lazy"
							referrerpolicy="no-referrer"
							onerror="this.remove()"
							class="absolute inset-0 h-full w-full object-cover"
						/>
					}
				</div>
				<div class="min-w-0">
					<div class="truncate text-sm font-semibold text-slate-100">{ draftPick.PlayerName }</div>
					if draftPick.Position != "" {
						<div class={ draftPositionBadgeClass(draftPick.Position) }>{ draftPick.Position }</div>
					}
				</div>
			</div>
			<div class="mt-auto space-y-2 border-t border-slate-800 pt-3">
				<div class="flex items-center justify-between gap-3 text-xs">
					<span class="font-semibold uppercase tracking-[0.16em] text-slate-600">Team</span>
					<span class="truncate text-right font-medium text-slate-300">{ draftPick.TeamName }</span>
				</div>
				if draftPick.KeeperStatus {
					<div class="inline-flex rounded-full border border-amber-300/30 bg-amber-300/10 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.16em] text-amber-100">
						Keeper
					</div>
				}
			</div>
		</div>
	</div>
}
