package templates
import (
	"github.com/Robert-litts/fantasy-football-archive/internal/archive"
	"strconv"
	"time"
)

templ Home(year int, startTime time.Time, seasonResults archive.SeasonResultList) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Fantasy Football Archive</title>
			// <script src="https://cdn.tailwindcss.com"></script>
			<link rel="stylesheet" href="/static/css/styles.css">
			<script src="/static/js/htmx.min.js"></script>
		</head>
		<body class="min-h-screen bg-gray-900 text-white">
			<div class="mx-auto max-w-6xl px-4 py-8">
				<section class="overflow-hidden rounded-3xl border border-amber-300/20 bg-slate-950 shadow-2xl shadow-black/30">
					<div class="relative border-b border-slate-800 bg-[radial-gradient(circle_at_top_left,_rgba(251,191,36,0.26),_transparent_34%),linear-gradient(135deg,_rgba(15,23,42,1),_rgba(17,24,39,0.96))] px-6 py-8">
						<p class="text-xs font-black uppercase tracking-[0.35em] text-amber-300">League archive</p>
						<h1 class="mt-3 text-4xl font-black tracking-tight text-white md:text-5xl">Dem Boys Fantasy Football League</h1>
						<p class="mt-3 max-w-3xl text-sm leading-6 text-slate-300">
							Lifelong friends, questionable roster decisions, and a record book that survived the jump from ESPN to Sleeper.
						</p>
						<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
							<div class="rounded-2xl border border-amber-300/30 bg-amber-300/10 px-4 py-3">
								<p class="text-xs font-bold uppercase tracking-[0.22em] text-amber-100/70">Running</p>
								<p class="mt-1 text-2xl font-black text-amber-100">{ strconv.Itoa(int(year)) } years</p>
							</div>
							<div class="rounded-2xl border border-slate-700 bg-slate-900/70 px-4 py-3">
								<p class="text-xs font-bold uppercase tracking-[0.22em] text-slate-500">Platforms</p>
								<p class="mt-1 text-sm font-bold text-slate-100">ESPN 2013-2021 · Sleeper 2022-present</p>
							</div>
							<div class="rounded-2xl border border-red-300/30 bg-red-400/10 px-4 py-3">
								<p class="text-xs font-bold uppercase tracking-[0.22em] text-red-100/70">Draft time</p>
								<p class="mt-1 text-sm font-bold text-red-100">
									if startTime.IsZero() {
										Draft time unavailable
									} else {
										{ startTime.Format("Mon, Jan 2 at 3:04PM MST") }
									}
								</p>
							</div>
						</div>
					</div>
					<div class="px-6 py-6">
						<div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5">
							<p class="text-xs font-bold uppercase tracking-[0.22em] text-slate-500">League information</p>
							<p class="mt-3 max-w-4xl text-sm leading-7 text-slate-300">
								Just some lifelong friends bickering over fantasy football since 2013. This league was played on ESPN from 2013-2021 and Sleeper from 2022-present.
								ESPN has since deleted all of the league's records from their site, so this is where the archive lives on.
							</p>
						</div>
					</div>
				</section>
				@SeasonResults(seasonResults)
			</div>
		</body>
	</html>
}
