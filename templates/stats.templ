package templates

import (
	appstats "github.com/Robert-litts/fantasy-football-archive/internal/stats"
	"strconv"
)

func statsNumber(value float64) string {
	if value == float64(int(value)) {
		return strconv.Itoa(int(value))
	}
	return strconv.FormatFloat(value, 'f', 2, 64)
}

func statsPct(value float64) string {
	return strconv.FormatFloat(value*100, 'f', 1, 64) + "%"
}

func statsRecordLine(wins, losses, ties int) string {
	return strconv.Itoa(wins) + "-" + strconv.Itoa(losses) + "-" + strconv.Itoa(ties)
}

templ Stats(pageData appstats.PageData) {
	<div class="min-h-screen px-4 py-8 bg-gray-900 text-white">
		<div class="max-w-7xl mx-auto space-y-10">
			<div class="rounded-3xl border border-gray-700 bg-gradient-to-br from-gray-800 via-gray-900 to-gray-950 p-8 shadow-2xl">
				<div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
					<div class="max-w-3xl space-y-3">
						<p class="text-sm uppercase tracking-[0.3em] text-blue-300">Historical stats</p>
						<h1 class="text-4xl font-black tracking-tight text-white">League records across every season</h1>
						<p class="text-base text-gray-300">A league like this deserves more than standings snapshots. This page highlights the moments and records that give the league its identity: huge weeks, brutal defeats, championship runs, and the owners whose names keep finding their way into the history books.</p>
					</div>
					<div class="grid grid-cols-3 gap-3 sm:gap-4">
						<div class="rounded-2xl border border-gray-700 bg-gray-800/70 px-4 py-3 text-center">
							<div class="text-xs uppercase tracking-wide text-gray-400">Seasons</div>
							<div class="mt-1 text-2xl font-bold text-white">{ strconv.Itoa(pageData.SeasonCount) }</div>
						</div>
						<div class="rounded-2xl border border-gray-700 bg-gray-800/70 px-4 py-3 text-center">
							<div class="text-xs uppercase tracking-wide text-gray-400">Owners</div>
							<div class="mt-1 text-2xl font-bold text-white">{ strconv.Itoa(pageData.OwnerCount) }</div>
						</div>
						<div class="rounded-2xl border border-gray-700 bg-gray-800/70 px-4 py-3 text-center">
							<div class="text-xs uppercase tracking-wide text-gray-400">Matchups</div>
							<div class="mt-1 text-2xl font-bold text-white">{ strconv.Itoa(pageData.MatchupCount) }</div>
						</div>
					</div>
				</div>
			</div>

			if len(pageData.HighlightCards) > 0 {
				<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-5">
					for _, card := range pageData.HighlightCards {
						@StatsHighlightCard(card)
					}
				</div>
			}

			<div class="grid gap-8 xl:grid-cols-[minmax(0,1.6fr)_minmax(320px,0.9fr)]">
				<div class="overflow-hidden rounded-3xl border border-gray-700 bg-gray-800/80 shadow-xl">
					<div class="border-b border-gray-700 px-6 py-5">
						<h2 class="text-2xl font-bold text-white">All-time owner totals</h2>
						<p class="mt-1 text-sm text-gray-400">Combined record, titles, playoff trips, and points across every season in the archive.</p>
					</div>
					<div class="overflow-x-auto">
						<table class="min-w-full divide-y divide-gray-700">
							<thead class="bg-gray-900/80">
								<tr>
									<th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Rank</th>
									<th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Owner</th>
									<th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Record</th>
									<th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Win %</th>
									<th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Titles</th>
									<th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Playoffs</th>
									<th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">PF</th>
									<th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">PA</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-gray-700 bg-gray-800/60">
								for _, owner := range pageData.OwnerTotals {
									<tr class="transition-colors hover:bg-gray-700/40">
										<td class="px-4 py-4 text-sm text-gray-300">{ strconv.Itoa(owner.Rank) }</td>
										<td class="px-4 py-4 text-sm font-semibold text-white">
											<div>{ owner.Owner }</div>
											<div class="text-xs text-gray-400">{ strconv.Itoa(owner.Seasons) } seasons</div>
										</td>
										<td class="px-4 py-4 text-sm text-gray-300">{ statsRecordLine(owner.Wins, owner.Losses, owner.Ties) }</td>
										<td class="px-4 py-4 text-sm text-gray-300">{ statsPct(owner.WinPct) }</td>
										<td class="px-4 py-4 text-sm text-yellow-300">{ strconv.Itoa(owner.Titles) }</td>
										<td class="px-4 py-4 text-sm text-gray-300">{ strconv.Itoa(owner.PlayoffAppearances) }</td>
										<td class="px-4 py-4 text-sm text-gray-300">{ strconv.Itoa(owner.PointsFor) }</td>
										<td class="px-4 py-4 text-sm text-gray-300">{ strconv.Itoa(owner.PointsAgainst) }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>

				<div class="space-y-8">
					<div class="overflow-hidden rounded-3xl border border-gray-700 bg-gray-800/80 shadow-xl">
						<div class="border-b border-gray-700 px-6 py-5">
							<h2 class="text-2xl font-bold text-white">Championship timeline</h2>
							<p class="mt-1 text-sm text-gray-400">Each champion is derived from the final winners-bracket matchup for that season.</p>
						</div>
						<div class="divide-y divide-gray-700">
							for _, champion := range pageData.Champions {
								<div class="flex items-start justify-between gap-4 px-6 py-4">
									<div>
										<div class="text-sm font-semibold text-white">{ champion.Owner }</div>
										<div class="text-xs text-gray-400">{ champion.TeamName } vs { champion.Opponent }</div>
									</div>
									<div class="text-right">
										<div class="text-sm font-medium text-yellow-300">{ strconv.Itoa(champion.Year) }</div>
										<div class="text-xs text-gray-400">{ statsNumber(champion.WinningScore) } - { statsNumber(champion.LosingScore) }</div>
									</div>
								</div>
							}
						</div>
					</div>
				</div>
			</div>

			<div class="overflow-hidden rounded-3xl border border-gray-700 bg-gray-800/80 shadow-xl">
				<div class="border-b border-gray-700 px-6 py-5">
					<h2 class="text-2xl font-bold text-white">Best regular seasons</h2>
					<p class="mt-1 text-sm text-gray-400">Sorted by win percentage, then wins, then points scored.</p>
				</div>
				<div class="overflow-x-auto">
					<table class="min-w-full divide-y divide-gray-700">
						<thead class="bg-gray-900/80">
							<tr>
								<th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Rank</th>
								<th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Owner</th>
								<th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Season</th>
								<th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Record</th>
								<th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Win %</th>
								<th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">PF</th>
								<th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">PA</th>
								<th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Finish</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-gray-700 bg-gray-800/60">
							for _, season := range pageData.BestRegularSeasons {
								<tr class="transition-colors hover:bg-gray-700/40">
									<td class="px-4 py-4 text-sm text-gray-300">{ strconv.Itoa(season.Rank) }</td>
									<td class="px-4 py-4 text-sm font-semibold text-white">{ season.Owner }</td>
									<td class="px-4 py-4 text-sm text-gray-300">{ strconv.Itoa(season.Year) }</td>
									<td class="px-4 py-4 text-sm text-gray-300">{ statsRecordLine(season.Wins, season.Losses, season.Ties) }</td>
									<td class="px-4 py-4 text-sm text-gray-300">{ statsPct(season.WinPct) }</td>
									<td class="px-4 py-4 text-sm text-gray-300">{ strconv.Itoa(season.PointsFor) }</td>
									<td class="px-4 py-4 text-sm text-gray-300">{ strconv.Itoa(season.PointsAgainst) }</td>
									<td class="px-4 py-4 text-sm text-gray-300">{ strconv.Itoa(season.FinalStanding) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
}

templ StatsHighlightCard(card appstats.HighlightCard) {
	<div class="overflow-hidden rounded-3xl border border-gray-700 bg-gradient-to-br from-gray-800 to-gray-900 p-5 shadow-xl">
		<div class="text-xs uppercase tracking-[0.2em] text-blue-300">{ card.Label }</div>
		<div class="mt-4 flex items-end gap-2">
			<div class="text-4xl font-black text-white">{ statsNumber(card.Value) }</div>
			<div class="pb-1 text-sm text-gray-400">{ card.ValueText }</div>
		</div>
		<div class="mt-4 space-y-1">
			<div class="text-sm font-semibold text-white">{ card.Owner }</div>
			if card.TeamName != "" {
				<div class="text-sm text-gray-300">{ card.TeamName }</div>
			}
			if card.Opponent != "" {
				<div class="text-xs text-gray-400">vs { card.Opponent }</div>
			}
			if card.Year > 0 {
				<div class="text-xs text-gray-500">Season { strconv.Itoa(card.Year) } - Week { strconv.Itoa(card.Week) }</div>
			}
			if card.Detail != "" {
				<div class="pt-2 text-xs text-gray-400">{ card.Detail }</div>
			}
		</div>
	</div>
}