package templates

import (
	"github.com/Robert-litts/fantasy-football-archive/internal/archive"
	matchupsview "github.com/Robert-litts/fantasy-football-archive/internal/matchupsview"
	"strconv"
)

templ Matchups(page matchupsview.PageData) {
	<div class="min-h-screen px-4 py-8">
		<div class="mx-auto max-w-7xl">
			<div class="rounded-2xl border border-slate-700 bg-slate-950/80 p-6 shadow-2xl shadow-black/20">
				<div class="mb-6 flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
					<div>
						<p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-400">Archive view</p>
						<h1 class="text-3xl font-bold text-white">Fantasy Football Matchups</h1>
						<p class="mt-2 max-w-3xl text-sm leading-6 text-slate-400">
							Week-by-week scoreboard history across ESPN and Sleeper, normalized into one clean season browser.
						</p>
						<div class="mt-4 flex flex-wrap gap-2">
							<span class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.22em] text-slate-300">
								ESPN 2013-2021
							</span>
							<span class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.22em] text-slate-300">
								Sleeper 2022-present
							</span>
							if page.SleeperAvailable {
								<span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.22em] text-emerald-200">
									Sleeper archive connected
								</span>
							} else {
								<span class="rounded-full border border-amber-500/30 bg-amber-500/10 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.22em] text-amber-100">
									Sleeper archive unavailable
								</span>
							}
						</div>
					</div>
					<div class="rounded-full border border-slate-700 bg-slate-900 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-300">
						{ strconv.Itoa(len(page.Leagues)) } seasons loaded
					</div>
				</div>
				<div id="matchups-content">
					@MatchupsContent(page)
				</div>
				<script>
					if (!window.__matchupsWeekTabsActiveBound) {
						window.__matchupsWeekTabsActiveBound = true;
						document.body.addEventListener("click", function (event) {
							var button = event.target.closest("[data-matchups-week-tab]");
							if (!button) {
								return;
							}
							var tabs = button.closest("#matchups-week-tabs");
							if (!tabs) {
								return;
							}
							tabs.querySelectorAll("[data-matchups-week-tab]").forEach(function (tab) {
								var isActive = tab === button;
								tab.className = isActive ? tab.dataset.activeClass : tab.dataset.inactiveClass;
								tab.setAttribute("aria-selected", isActive ? "true" : "false");
							});
							var label = document.getElementById("matchups-active-week-label");
							if (label) {
								label.textContent = button.dataset.weekLabel;
							}
						});
					}
				</script>
			</div>
		</div>
	</div>
}

func matchupsLeagueSelectionKey(league archive.LeagueSummary) string {
	return string(league.Provider) + ":" + strconv.FormatInt(league.ID, 10)
}

templ MatchupsContent(page matchupsview.PageData) {
	<div class="space-y-6">
		@LeagueMatchupSelector(page.Leagues, page.SelectedLeagueKey)
		if page.SleeperMessage != "" {
			<div class="rounded-xl border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-100">
				{ page.SleeperMessage }
			</div>
		}
		<div class="overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/60 shadow-xl">
			<div class="border-b border-slate-800 px-5 py-4">
				<div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
					<div>
						<p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Season detail</p>
						if page.SelectedLeague.Name != "" {
							<h2 class="mt-1 text-2xl font-bold text-white">{ page.SelectedLeague.Name }</h2>
							<p class="mt-1 text-sm text-slate-400">
								{ string(page.SelectedLeague.Provider) } · Season { strconv.Itoa(int(page.SelectedLeague.Season)) } · { strconv.Itoa(len(page.Matchups)) } matchups loaded
							</p>
						} else {
							<h2 class="mt-1 text-2xl font-bold text-white">No season selected</h2>
							<p class="mt-1 text-sm text-slate-400">Choose a league to load weekly matchup history.</p>
						}
					</div>
					<div id="matchups-active-week-label" class="rounded-full border border-slate-700 bg-slate-950 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-300">
						Week { strconv.Itoa(int(page.ActiveWeek)) }
					</div>
				</div>
			</div>
			<div id="matchups-container" class="p-5">
				@WeekContent(page)
			</div>
		</div>
	</div>
}

templ LeagueMatchupSelector(leagues []archive.LeagueSummary, selectedLeagueKey string) {
	<div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-4 shadow-inner shadow-black/10">
		<label for="matchups-league-select" class="block text-xs font-bold uppercase tracking-[0.22em] text-slate-500">Select season</label>
		<select
			id="matchups-league-select"
			hx-get="/app/fragments/matchups-table"
			hx-target="#matchups-content"
			hx-swap="innerHTML"
			hx-trigger="change"
			name="id"
			class="mt-3 w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm font-semibold text-slate-100 outline-none transition focus:border-amber-300/50 focus:ring-2 focus:ring-amber-300/20 sm:w-auto"
		>
			for _, league := range leagues {
				<option
					value={ matchupsLeagueSelectionKey(league) }
					selected?={ matchupsLeagueSelectionKey(league) == selectedLeagueKey }
				>
					{ strconv.Itoa(int(league.Season)) } · { string(league.Provider) } · { league.Name }
				</option>
			}
		</select>
	</div>
}

templ WeekContent(page matchupsview.PageData) {
	<div class="space-y-5">
		@MatchupWeekTabs(page)
		<div id="week-table-container">
			@WeekTable(page.SelectedWeekRows)
		</div>
	</div>
}

templ MatchupWeekTabs(page matchupsview.PageData) {
	if len(page.Weeks) > 0 {
		<div id="matchups-week-tabs" class="flex gap-2 overflow-x-auto border-b border-slate-800 pb-3" role="tablist">
			for _, week := range page.Weeks {
				@matchupWeekTab(week, page.ActiveWeek, page.SelectedLeagueKey)
			}
		</div>
	}
}

templ matchupWeekTab(week matchupsview.WeekTab, activeWeek int32, selectedLeagueKey string) {
	<button
		class={ matchupWeekTabClass(week.Week == activeWeek) }
		hx-get={ "/app/fragments/matchups-week/" + strconv.Itoa(int(week.Week)) + "?id=" + selectedLeagueKey }
		hx-target="#week-table-container"
		hx-swap="innerHTML"
		hx-trigger="click"
		data-matchups-week-tab="true"
		data-week-label={ "Week " + strconv.Itoa(int(week.Week)) }
		data-active-class={ matchupWeekTabClass(true) }
		data-inactive-class={ matchupWeekTabClass(false) }
		role="tab"
		aria-selected={ strconv.FormatBool(week.Week == activeWeek) }
	>
		Week { strconv.Itoa(int(week.Week)) }
		if week.IsChampionship {
			<span class="rounded-full bg-amber-300/15 px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.18em] text-amber-100">Title</span>
		} else if week.IsPlayoff {
			<span class="rounded-full bg-sky-400/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.18em] text-sky-200">Playoffs</span>
		}
	</button>
}

func matchupWeekTabClass(active bool) string {
	base := "flex shrink-0 items-center gap-2 rounded-full border px-4 py-2 text-sm font-semibold transition"
	if active {
		return base + " border-amber-300/50 bg-amber-300/10 text-amber-100"
	}
	return base + " border-slate-700 bg-slate-950 text-slate-400 hover:border-slate-500 hover:text-white"
}

templ WeekTable(weekMatchups []matchupsview.MatchupRow) {
	<div class="overflow-x-auto rounded-2xl border border-slate-800">
		<table class="min-w-full divide-y divide-slate-800 bg-slate-950">
			<thead class="bg-slate-900/80">
				<tr>
					<th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Home</th>
					<th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Score</th>
					<th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Score</th>
					<th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Away</th>
					<th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Type</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-slate-800 bg-slate-950">
				for _, matchup := range weekMatchups {
					<tr class="transition-colors hover:bg-slate-900/70">
						<td class="px-5 py-4 text-sm text-slate-200">
							<div class={ teamNameClass(matchup.HomePresent, matchup.HomeWinner, matchup.IsChampionship, matchup.AwayWinner) }>
								{ matchup.HomeTeamName }
							</div>
							if matchup.HomeOwner != "" {
								<div class="mt-1 text-xs text-slate-500">{ matchup.HomeOwner }</div>
							}
						</td>
						<td class={ scoreCellClass(matchup.HomePresent, matchup.AwayPresent, matchup.HomeWinner, matchup.IsChampionship) }>
							if matchup.HomePresent && matchup.AwayPresent {
								<span class="inline-flex items-center gap-2">
									{ matchup.HomeScore }
									if matchup.HomeWinner && matchup.IsChampionship {
										@trophyIcon("h-4 w-4 text-yellow-200 drop-shadow-[0_0_6px_rgba(250,204,21,0.55)]")
									}
									if matchup.IsChampionship && matchup.AwayWinner && !matchup.HomeWinner {
										@trophyIcon("h-4 w-4 text-slate-200 drop-shadow-[0_0_5px_rgba(226,232,240,0.45)]")
									}
								</span>
							} else {
								-
							}
						</td>
						<td class={ scoreCellClass(matchup.AwayPresent, matchup.HomePresent, matchup.AwayWinner, matchup.IsChampionship) }>
							if matchup.HomePresent && matchup.AwayPresent {
								<span class="inline-flex items-center gap-2">
									{ matchup.AwayScore }
									if matchup.AwayWinner && matchup.IsChampionship {
										@trophyIcon("h-4 w-4 text-yellow-200 drop-shadow-[0_0_6px_rgba(250,204,21,0.55)]")
									}
									if matchup.IsChampionship && matchup.HomeWinner && !matchup.AwayWinner {
										@trophyIcon("h-4 w-4 text-slate-200 drop-shadow-[0_0_5px_rgba(226,232,240,0.45)]")
									}
								</span>
							} else {
								-
							}
						</td>
						<td class="px-5 py-4 text-sm text-slate-200">
							<div class={ teamNameClass(matchup.AwayPresent, matchup.AwayWinner, matchup.IsChampionship, matchup.HomeWinner) }>
								{ matchup.AwayTeamName }
							</div>
							if matchup.AwayOwner != "" {
								<div class="mt-1 text-xs text-slate-500">{ matchup.AwayOwner }</div>
							}
						</td>
						<td class="whitespace-nowrap px-5 py-4 text-sm text-slate-300">
							<span class={
								"rounded-full border px-3 py-1 text-xs font-semibold",
								templ.KV("border-amber-300/40 bg-amber-300/10 text-amber-100", matchup.IsChampionship),
								templ.KV("border-sky-400/30 bg-sky-400/10 text-sky-200", matchup.IsPlayoff && !matchup.IsChampionship),
								templ.KV("border-slate-700 bg-slate-900 text-slate-300", !matchup.IsPlayoff && !matchup.IsChampionship),
							}>
								{ matchup.TypeLabel }
							</span>
						</td>
					</tr>
				}
				if len(weekMatchups) == 0 {
					<tr>
						<td colspan="5" class="px-5 py-8 text-center text-sm text-slate-500">
							No matchups found for this week.
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ trophyIcon(className string) {
	<svg aria-hidden="true" class={ className } viewBox="0 0 24 24" fill="currentColor">
		<path d="M7 3h10v2h3a1 1 0 0 1 1 1v2a5 5 0 0 1-5 5h-.21A5.99 5.99 0 0 1 13 15.92V19h3v2H8v-2h3v-3.08A5.99 5.99 0 0 1 8.21 13H8a5 5 0 0 1-5-5V6a1 1 0 0 1 1-1h3V3Zm0 4H5v1a3 3 0 0 0 2.17 2.88A6.17 6.17 0 0 1 7 9.5V7Zm12 0h-2v2.5c0 .47-.05.93-.16 1.38A3 3 0 0 0 19 8V7Z"></path>
	</svg>
}

func scoreCellClass(primaryPresent, opponentPresent, isWinner, isChampionship bool) string {
	base := "whitespace-nowrap px-5 py-4 text-sm font-semibold text-slate-300"
	if !primaryPresent || !opponentPresent {
		return base + " bg-slate-900/60 text-slate-500"
	}
	if isWinner && isChampionship {
		return base + " bg-yellow-300/25 text-yellow-50 ring-1 ring-inset ring-yellow-200/40 shadow-[inset_0_0_18px_rgba(250,204,21,0.18)]"
	}
	if isChampionship {
		return base + " bg-slate-300/15 text-slate-100 ring-1 ring-inset ring-slate-100/25 shadow-[inset_0_0_16px_rgba(226,232,240,0.12)]"
	}
	if isWinner {
		return base + " bg-teal-400/15 text-teal-50 ring-1 ring-inset ring-teal-200/15"
	}
	return base + " bg-slate-900/70 text-slate-400"
}

func teamNameClass(present, isWinner, isChampionship, opponentWinner bool) string {
	base := "font-semibold"
	if !present {
		return base + " text-slate-500"
	}
	if isChampionship && isWinner {
		return base + " text-yellow-50 drop-shadow-[0_0_8px_rgba(250,204,21,0.42)]"
	}
	if isChampionship && opponentWinner {
		return base + " text-slate-100 drop-shadow-[0_0_7px_rgba(226,232,240,0.32)]"
	}
	return base + " text-white"
}
